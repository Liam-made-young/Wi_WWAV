{
  "$doc": "Every token in the app (docs/SPEC.md 8.11). tools/tokens/compile.mjs compiles it into app/ui/src/styles/tokens.css, crates/wwav-tokens/src/generated.rs and engine/include/wwav_tokens.h. A value is a colour (#rrggbb or rgba(r, g, b, a)), a list of colours (a gradient's stops, top or centre first), a number, a number with a unit (px, ms or em), a cubic-bezier() curve, or a list of names. {light, dark} gives each appearance its own value; anything else is the same in both. Keys starting with $ are notes and checks, not tokens.",

  "desk": {
    "$doc": "Heat and the Console's chrome, Settings and every sheet (8.2). Light and dark are Heat's tokens with 8.2's five fixes.",
    "ink": { "light": "#1b1b1b", "dark": "#ececec" },
    "ink2": { "light": "#4a4a4a", "dark": "#c2c2c2" },
    "ink3": { "light": "#5f5f5f", "dark": "#9a9a9a" },
    "well": { "light": "#ffffff", "dark": "#26282b" },
    "stripe": { "light": "#edf3fe", "dark": "#2c3038" },
    "caseMetal": { "light": ["#e4e4e4", "#c9c9c9"], "dark": ["#5a5d61", "#3f4246"] },
    "deckMetal": { "light": ["#FBFCFD", "#E6EAEF", "#C9D0D8"], "dark": ["#5a5d61", "#3f4246"] },
    "deckEdge": { "light": "#98A2AD", "dark": "#26282b" },
    "deckPinstripe": { "light": "#E9EFF6", "dark": "rgba(0, 0, 0, 0)" },
    "pinstripeEvery": "4px",
    "deckInk": { "light": "#161D26", "dark": "#ececec" },
    "deckInkSoft": { "light": "#5D6975", "dark": "#ececec" },
    "select": "#1B4C8C",
    "selectInk": "#ffffff",
    "selectBar": "3px",
    "highlight": { "light": "#3875D7", "dark": "#3a6fc4" },
    "focus": { "light": "rgba(56, 117, 215, 0.6)", "dark": "rgba(58, 111, 196, 0.6)" },
    "focusWidth": "3px",
    "gelSelected": ["#336dcc", "#1B4C8C"],
    "gelPress": 0.88,
    "backdrop": "rgba(0, 0, 0, 0.25)",
    "lcd": {
      "$doc": "The Now strip: Heat's olive LCD, with its dim text darkened (2.2, 8.2).",
      "ground": { "light": ["#f2f4e4", "#dfe3c6"], "dark": ["#2c3121", "#20241a"] },
      "ink": { "light": "#262a17", "dark": "#d7e0a8" },
      "dim": { "light": "#4b5034", "dark": "#8e9670" }
    },
    "sourceList": {
      "$doc": "The library drawer and Heat's sidebar, with headings darkened (8.2).",
      "ground": { "light": "#e7ecf2", "dark": "#2e3136" },
      "heading": { "light": "#4f5761", "dark": "#9aa3ad" }
    }
  },

  "screen": {
    "$doc": "The Game Boy inside: every Console readout is a DMG screen, the same in light and dark (8.2, 5.2; MI-WWAV-OS theme.dart). Meters are DMG green to -6 dBFS, amber to -1, rec above.",
    "dmg": {
      "deep": "#0B1F0B",
      "dark": "#0F380F",
      "mid": "#306230",
      "lit": "#8BAC0F"
    },
    "glow": "#C6E24A",
    "amber": "#F0A32E",
    "rec": "#E0453A",
    "meterAmberFromDb": -6,
    "meterRecFromDb": -1
  },

  "night": {
    "$doc": "Space and the expanded player, in both appearances (8.2; v3, v4). Seven ink opacities are the only hierarchy scale; royal blue has three uses and is never text.",
    "ground": "#070A18",
    "deep": "#030510",
    "clay": "#1A2142",
    "ink": "#F4EFE6",
    "inkSteps": [1.0, 0.70, 0.50, 0.35, 0.20, 0.12, 0.07],
    "textSteps": { "body": [1.0, 0.70], "secondary": [0.50] },
    "star": "#DDE4FB",
    "accent": "#2946FF",
    "accentUses": ["armed", "branch", "commit"],
    "sun": ["#fff8e6", "#ffd89a", "#f0a23c", "#b25f12"],
    "focusWidth": "2px"
  },

  "room": {
    "$doc": "Unquantized, lit rather than painted (8.2; v3's mock, PRANA, Crater). Dusk is light, after hours is dark: the walls fall to limousine and paper stays paper.",
    "field": {
      "ground": { "light": ["#F7F4EE", "#E6DFD0"], "dark": ["#0F0C09", "#0F0C09"] },
      "rose": "#FBEDE8",
      "cool": "#DDE2E6",
      "driftShortest": "53000ms",
      "driftLongest": "131000ms"
    },
    "material": {
      "sand": "#E8DCC8",
      "sandDeep": "#D4C4A8",
      "clay": "#B89878",
      "clayDeep": "#7A5E45"
    },
    "ink": "#3D2E22",
    "ink2": "#6B5643",
    "paper": "#FFE9C8",
    "accent": "#C89668",
    "lamp": ["#e8915b", "#f4b483"],
    "sky": ["#f8d0a4", "#d4763f"],
    "hairline": "1px",
    "focusWidth": "2px"
  },

  "stem": {
    "$doc": "PRANA's stem colours, the same everywhere, in stem order (8.3). Every stem mark carries a ring in its register's ink; state is shape: muted is a stem-colour ring, soloed adds an outer ring, silent under a solo fills at 45% with a dashed ring, selected adds a notch.",
    "vocals": "#D23C2A",
    "drums": "#F0B90B",
    "other": "#2E9A55",
    "bass": "#1F4E9E",
    "ring": "1px",
    "mutedRing": "2px",
    "soloRing": "2px",
    "silentFill": 0.45,
    "notch": "2px"
  },

  "heat": {
    "$doc": "Heat's level colours (3.1). They fill tubes, pill borders and dots; the level word is ink.",
    "cool": "#4f9be6",
    "warm": "#efa431",
    "hot": "#e0402c",
    "overdue": "#8f1d16"
  },

  "label": {
    "$doc": "The six colour labels, for sorting only (2.5).",
    "red": "#E0383E",
    "orange": "#F08A2C",
    "yellow": "#E8C73A",
    "green": "#3CAA68",
    "blue": "#3D7DD5",
    "purple": "#9359C9"
  },

  "key": {
    "$doc": "A work's key colour (8.3, v4 keyColor.js): hue = ((pc * 7) mod 12) * 30 with A = 0, in hsl with the mode's saturation and lightness. An unknown key is night indigo in the minor look. The glow tone an orb's rim takes is the same hue and saturation at the glow lightness.",
    "unknownHue": 232,
    "major": { "saturation": 72, "lightness": 58 },
    "minor": { "saturation": 58, "lightness": 42 },
    "glowLightness": 65
  },

  "light": {
    "$doc": "One light, from the upper left, as a fraction of the box (8.3, v3 WWAVLight.sun).",
    "sun": { "x": 0.30, "y": 0.25 }
  },

  "motion": {
    "$doc": "Built on MI-WWAV-OS's 140 ms beat with v4's curves (8.6). Under Reduce Motion every move is a beat-long cross-fade. Nothing bounces.",
    "press": "70ms",
    "beat": "140ms",
    "fade": "280ms",
    "morph": "420ms",
    "wash": "760ms",
    "dive": "900ms",
    "toast": "2600ms",
    "rest": "cubic-bezier(0.22, 1, 0.36, 1)",
    "sheet": "cubic-bezier(0.32, 0.72, 0, 1)"
  },

  "space": {
    "$doc": "A 4 px grid (8.3).",
    "s1": "4px",
    "s2": "8px",
    "s3": "12px",
    "s4": "16px",
    "s5": "24px",
    "s6": "32px",
    "s7": "48px",
    "s8": "64px"
  },

  "radius": {
    "$doc": "Corners (8.3). Gels are full pills; a sheet rounds only its lower corners.",
    "chip": "6px",
    "button": "10px",
    "card": "14px",
    "sheet": "8px",
    "pill": "999px"
  },

  "type": {
    "$doc": "Faces and sizes (8.4). Nothing is under 11; text read for more than a line is at least the reading size (8.9, open: 17 or 19).",
    "desk": {
      "family": ["Lucida Grande", "Lucida Sans Unicode", "Lucida Sans", "sans-serif"],
      "small": "11px",
      "body": "13px",
      "large": "15px",
      "title": "20px",
      "lineHeight": 1.35
    },
    "mono": {
      "family": ["Menlo", "Consolas", "monospace"],
      "small": "11px",
      "body": "13px",
      "large": "20px"
    },
    "name": {
      "family": ["Cormorant Garamond", "serif"],
      "min": "20px",
      "header": "30px",
      "sun": "46px",
      "lineHeight": 1.18,
      "weight": 400,
      "lightWeight": 300,
      "lightWeightFrom": "28px"
    },
    "text": {
      "family": ["Inter", "sans-serif"],
      "label": "11px",
      "labelTracking": "0.08em",
      "small": "13px",
      "body": "15px",
      "reading": "17px"
    },
    "sign": {
      "family": ["Jost", "sans-serif"],
      "min": "11px",
      "max": "15px",
      "tracking": "0.34em"
    }
  },

  "$contrast": {
    "$doc": "Every pair the spec measures (8.2, 8.3, 8.11, 7.18). role is body (7:1), secondary (4.5:1) or mark (a ring, fill or light that never carries text, so no bar). A pair is judged in light and dark on every colour of its ground: each stop of a gradient, each ground in a list, or only the stops named in over. alpha lays the ink over the ground first. quoted is the ratio the spec gives.",
    "pairs": [
      { "ink": "desk.ink", "on": "desk.well", "role": "body", "quoted": { "light": 17.2, "dark": 12.5 } },
      { "ink": "desk.ink2", "on": "desk.well", "role": "body", "quoted": { "light": 8.9, "dark": 8.3 } },
      { "ink": "desk.ink3", "on": "desk.well", "role": "secondary", "quoted": { "light": 6.4, "dark": 5.3 } },
      { "ink": "desk.ink", "on": "desk.stripe", "role": "body", "quoted": { "light": 15.5 } },
      { "ink": "desk.ink2", "on": "desk.stripe", "role": "body" },
      { "ink": "desk.ink3", "on": "desk.stripe", "role": "secondary" },
      { "ink": "desk.ink", "on": "desk.caseMetal", "role": "secondary", "quoted": { "light": 10.4 },
        "why": "Words on metal are labels; running text sits in a well." },
      { "ink": "desk.deckInk", "on": "desk.deckMetal", "over": [0, 1], "role": "secondary", "quoted": { "light": 14.0 },
        "why": "Deck labels sit over the top and middle stops; the soft ink is 3.6:1 on the bottom one." },
      { "ink": "desk.deckInkSoft", "on": "desk.deckMetal", "over": [0, 1], "role": "secondary", "quoted": { "light": 4.6 },
        "why": "As above." },
      { "ink": "desk.selectInk", "on": "desk.select", "role": "body", "quoted": { "light": 8.5, "dark": 8.5 } },
      { "ink": "desk.selectInk", "on": "desk.gelSelected", "role": "secondary", "quoted": { "light": 5.0, "dark": 5.0 } },
      { "ink": "desk.selectInk", "on": "desk.highlight", "role": "mark", "quoted": { "light": 4.47 },
        "why": "Too low for white text, so the highlight is a ring, a gel and a bar (8.2)." },
      { "ink": "desk.lcd.ink", "on": "desk.lcd.ground", "role": "body", "quoted": { "light": 11.2, "dark": 9.6 } },
      { "ink": "desk.lcd.dim", "on": "desk.lcd.ground", "over": [1], "role": "secondary", "quoted": { "light": 6.4, "dark": 5.1 },
        "why": "The dim line is the LCD's second line, over its lower half (2.2); the dark dim is 4.3:1 on the top stop." },
      { "ink": "desk.sourceList.heading", "on": "desk.sourceList.ground", "role": "secondary", "quoted": { "light": 6.2, "dark": 5.1 } },
      { "ink": "desk.ink", "on": "desk.sourceList.ground", "role": "body" },
      { "ink": "heat.hot", "on": "desk.well", "role": "mark", "quoted": { "light": 4.25 } },
      { "ink": "stem.drums", "on": "desk.deckMetal", "over": [1], "role": "mark", "quoted": { "light": 1.5 } },
      { "ink": "screen.dmg.lit", "on": ["screen.dmg.deep", "screen.dmg.dark"], "role": "secondary", "quoted": { "light": 5.0, "dark": 5.0 } },
      { "ink": "screen.glow", "on": ["screen.dmg.deep", "screen.dmg.dark"], "role": "body", "quoted": { "light": 9.0, "dark": 9.0 } },
      { "ink": "screen.amber", "on": ["screen.dmg.deep", "screen.dmg.dark"], "role": "secondary", "quoted": { "light": 6.3, "dark": 6.3 } },
      { "ink": "screen.rec", "on": "screen.dmg.dark", "role": "mark", "quoted": { "light": 3.2, "dark": 3.2 } },
      { "ink": "night.ink", "alpha": 1.0, "on": ["night.ground", "night.deep"], "role": "body", "quoted": { "light": 17.2, "dark": 17.2 } },
      { "ink": "night.ink", "alpha": 0.70, "on": ["night.ground", "night.deep"], "role": "body", "quoted": { "light": 8.5, "dark": 8.5 } },
      { "ink": "night.ink", "alpha": 0.50, "on": ["night.ground", "night.deep"], "role": "secondary", "quoted": { "light": 4.8, "dark": 4.8 } },
      { "ink": "night.star", "on": "night.ground", "role": "mark", "quoted": { "light": 15.5, "dark": 15.5 } },
      { "ink": "night.accent", "on": "night.ground", "role": "mark", "quoted": { "light": 3.2, "dark": 3.2 } },
      { "ink": "stem.bass", "on": "night.ground", "role": "mark", "quoted": { "light": 2.5, "dark": 2.5 } },
      { "ink": "room.ink", "on": "room.material.sand", "role": "body", "quoted": { "light": 9.6, "dark": 9.6 } },
      { "ink": "room.ink2", "on": "room.material.sand", "role": "secondary", "quoted": { "light": 5.1, "dark": 5.1 } },
      { "ink": "room.ink", "on": "room.paper", "role": "body", "quoted": { "light": 11.0, "dark": 11.0 } },
      { "ink": "room.ink2", "on": "room.paper", "role": "secondary" },
      { "ink": "room.accent", "on": "room.material.sand", "role": "mark", "quoted": { "light": 1.9, "dark": 1.9 } }
    ]
  }
}
