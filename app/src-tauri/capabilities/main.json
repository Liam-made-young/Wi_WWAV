{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window: every core command, the core's events, dragging the title bar, and the system's open and save pickers (docs/SPEC.md 9.8).",
  "windows": ["main"],
  "permissions": [
    { "identifier": "allow-core", "allow": [{ "cmd": "*" }] },
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
