{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "The settings window (docs/SPEC.md 2.13) reads and changes settings, the account and the engine's devices, cleans up media, and picks folders. Its Learn panes (spaces, school and calendars; Claude; Privacy) reach the Learn commands they need, not Learn's day-to-day ones. It can't touch the library's clips, publish or buy.",
  "windows": ["settings"],
  "permissions": [
    {
      "identifier": "allow-core",
      "allow": [
        { "cmd": "app.hello" },
        { "cmd": "app.settings.*" },
        { "cmd": "account.*" },
        { "cmd": "engine.*" },
        { "cmd": "library.cleanup.*" },
        { "cmd": "library.trash.empty" },
        { "cmd": "heat.snapshot" },
        { "cmd": "heat.put" },
        { "cmd": "heat.patch" },
        { "cmd": "heat.delete" },
        { "cmd": "heat.school.set" },
        { "cmd": "heat.mail.accounts.set" },
        { "cmd": "heat.calendars.*" },
        { "cmd": "heat.claude.*" },
        { "cmd": "heat.public.set" },
        { "cmd": "heat.publicView" },
        { "cmd": "history.undoEntry" }
      ]
    },
    "dialog:allow-open"
  ]
}
